# audio_server — environment variables consumed by Config::from_env()
# (server/src/config.rs). Copy to `.env`, fill secrets, and source before
# `cargo run --release -p audio-server`.

# ─── Networking ───────────────────────────────────────────────
AUDIO_PUBLIC_HOST=audio.example.com
AUDIO_BIND_IP=0.0.0.0
AUDIO_UDP_PORT=4002
AUDIO_WS_PORT=3001
AUDIO_MESH_PORT=4003
AUDIO_METRICS_PORT=9100
# u32 unique per node. Must differ across every live cluster member.
AUDIO_SERVER_ID=1

# ─── Redis Sentinel ────────────────────────────────────────────
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=mymaster
# REDIS_PASSWORD=

# ─── REST API ─────────────────────────────────────────────────
REST_BASE_URL=https://api.example.com/v1
# REST_API_KEY=

# ─── Crypto ────────────────────────────────────────────────────
# 32-byte mesh key (hex, 64 chars). Identical across all mesh peers.
MESH_KEY_HEX=0011223344556677889900aabbccddeeff00112233445566778899aabbccddee

# ─── Session policy ────────────────────────────────────────────
AUDIO_DEFAULT_MODE=mix
AUDIO_MAX_SUBSCRIPTIONS=50
AUDIO_MAX_ACTIVE_TALKERS=8
AUDIO_MAX_SESSIONS_PER_SERVER=4000

# ─── JWT auth ─────────────────────────────────────────────────
JWT_AUDIENCE=redenes-audio
JWT_ISSUER=redenes-auth
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Logging ──────────────────────────────────────────────────
LOG_FORMAT=pretty
